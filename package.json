{
  "name": "otp-message-extractor",
  "version": "0.1.0",
  "description": "Dependency-free JavaScript OTP and verification code extractor for Arabic/English SMS text. Parses 4-8 digit and alphanumeric codes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahm0ud55/otp-message-extractor.git"
  },
  "homepage": "https://github.com/mahm0ud55/otp-message-extractor#readme",
  "bugs": {
    "url": "https://github.com/mahm0ud55/otp-message-extractor/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "otp",
    "otp-extractor",
    "otp-parser",
    "otp-detector",
    "sms-otp",
    "sms-parser",
    "verification-code",
    "verification-code-extractor",
    "one-time-password",
    "passcode",
    "2fa",
    "mfa",
    "authentication",
    "email-otp",
    "alphanumeric-otp",
    "arabic",
    "arabic-otp",
    "javascript",
    "typescript",
    "nodejs",
    "receive-sms",
    "virtual-number",
    "temporary-number"
  ],
  "author": "mahm0ud55",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
